  r-compute-height :
    HCL(aw, _, pw, HorizontalContainer(AllData(px, py, h, w, rw, t, info, bgColor), es), HorizontalContainerListEnd()) ->
      HCL(aw, h, pw, HorizontalContainer(AllData(px, py, h, w, rw, t, info, bgColor), es), HorizontalContainerListEnd())
      
  r-compute-height :
    HCL(aw, _, pw, HorizontalContainer(AllData(px, py, h, w, rw, t, info, bgColor), es), HorizontalContainerListInner(HCL(nw, nh, npw, nc, nn))) ->
      HCL(aw, (<add> (h, nh)), pw, HorizontalContainer(AllData(px, py, h, w, rw, t, info, bgColor), es), HorizontalContainerListInner(HCL(nw, nh, npw, nc, nn)))
      
  r-compute-height :
    HorizontalContainer(AllData(px, py, _, w, rw, t, info, bgColor), EL(aw, mh, pw, e, es)) ->
      HorizontalContainer(AllData(px, py, mh, w, rw, t, info, bgColor), EL(aw, mh, pw, e, es))
      
  r-compute-height :
    EL(aw, _, pw, Element(AllData(px, py, h, w, rw, t, info, bgColor), e), ElementListEnd()) ->
      EL(aw, h, pw, Element(AllData(px, py, h, w, rw, t, info, bgColor), e), ElementListEnd())
      
  r-compute-height :
    EL(aw, _, pw, Element(AllData(px, py, h, w, rw, t, info, bgColor), e), ElementListInner(EL(nw, nh, npw, ne, nn))) ->
      EL(aw, (<max> (h, nh)), pw, Element(AllData(px, py, h, w, rw, t, info, bgColor), e), ElementListInner(EL(nw, nh, npw, ne, nn)))
      
  r-compute-height :
    Element(AllData(px, py, _, w, rw, t, FontInfo(ft, fs, fc), bgColor), TextBox(s)) -> 
      Element(AllData(px, py, (<mul> (2, (<div> ((<mul> ((<strlen> s), fs)), w)))), w, rw, t, FontInfo(ft, fs, fc), bgColor), TextBox(s))
      
  r-compute-height :
    Element(AllData(px, py, _, w, rw, t, info, bgColor), Image(path, ow, oh, url)) ->
      Element(AllData(px, py, (<mul> (w, (<div> (oh, ow)))), w, rw, t, info, bgColor), Image(path, ow, oh, url))
      
  r-compute-height :
    Element(AllData(px, py, _, w, rw, t, info, bgColor), VerticalContainer(HCL(mw, ah, pw, hc, hcs))) ->
      Element(AllData(px, py, ah, w, rw, t, info, bgColor), VerticalContainer(HCL(mw, ah, pw, hc, hcs))) 
      
  r-compute-height :
    Element(AllData(px, py, _, w, rw, t, info, bgColor), List(ListItemEnd(s, linfo, ahs), im, lsz)) ->
      Element(AllData(px, py, (<div> ((<add> (ahs, (<mul> (im, lsz)))), w)), w, rw, t, info, bgColor), List(ListItemEnd(s, linfo, ahs), im, lsz))
      
  r-compute-height :
    Element(AllData(px, py, _, w, rw, t, info, bgColor), List(ListItemInner(s, linfo, ahs, ls), im, lsz)) ->
      Element(AllData(px, py, (<div> ((<add> (ahs, (<mul> (im, lsz)))), w)), w, rw, t, info, bgColor), List(ListItemInner(s, linfo, ahs, ls), im, lsz))
      
  r-compute-height :
    ListItemEnd(s, FontInfo(ft, fs, fc), _) -> ListItemEnd(s, FontInfo(ft, fs, fc), (<mul> ((<strlen> s), fs)))
    
  r-compute-height :
    ListItemInner(s, FontInfo(ft, fs, fc), _, ListItemEnd(es, einfo, eahs)) ->
      ListItemInner(s, FontInfo(ft, fs, fc), (<add> ((<mul> ((<strlen> s), fs)), eahs)), ListItemEnd(es, einfo, eahs))
      
  r-compute-height :
    ListItemInner(s, FontInfo(ft, fs, fc), _, ListItemInner(es, einfo, eahs, els)) ->
      ListItemInner(s, FontInfo(ft, fs, fc), (<add> ((<mul> ((<strlen> s), fs)), eahs)), ListItemInner(es, einfo, eahs, els))
  
  
  
  
  
  r-compute-positions :
    Page(AllData(_, _, h, w, rw, t, info, bgColor), HCL(mw, ah, pw, HorizontalContainer(AllData(_, _, hh, hw, hrw, ht, hinfo, hbgColor), es), hcs)) ->
      Page(AllData(0, 0, h, w, rw, t, info, bgColor), HCL(mw, ah, pw, HorizontalContainer(AllData(0, 0, hh, hw, hrw, ht, hinfo, hbgColor), es), hcs))
      
  r-compute-positions :
    HCL(mw, ah, pw, HorizontalContainer(AllData(px, py, h, w, rw, t, info, bgColor), es), HorizontalContainerListInner(HCL(nmw, nah, npw, HorizontalContainer(AllData(_, _, nh, nw, nrw, nt, ninfo, nbgColor), nes), hcs))) ->
      HCL(mw, ah, pw, HorizontalContainer(AllData(px, py, h, w, rw, t, info, bgColor), es), HorizontalContainerListInner(HCL(nmw, nah, npw, HorizontalContainer(AllData(px, (<add> (py, h)), nh, nw, nrw, nt, ninfo, nbgColor), nes), hcs)))
      
  r-compute-positions :
    HorizontalContainer(AllData(px, py, h, w, rw, t, info, bgColor), EL(aw, mh, pw, Element(AllData(_, _, nh, nw, nrw, nt, ninfo, nbgColor), e), es)) ->
      HorizontalContainer(AllData(px, py, h, w, rw, t, info, bgColor), EL(aw, mh, pw, Element(AllData(px, py, nh, nw, nrw, nt, ninfo, nbgColor), e), es))
      
  r-compute-positions :
    EL(aw, mh, pw, Element(AllData(px, py, h, w, rw, t, info, bgColor), e), ElementListInner(EL(naw, nmh, npw, Element(AllData(_, _, nh, nw, nrw, nt, ninfo, nbgColor), ne), es))) ->
      EL(aw, mh, pw, Element(AllData(px, py, h, w, rw, t, info, bgColor), e), ElementListInner(EL(naw, nmh, npw, Element(AllData((<add> (px, w)), py, nh, nw, nrw, nt, ninfo, nbgColor), ne), es)))
      
  r-compute-positions :
    Element(AllData(px, py, h, w, rw, t, info, bgColor), VerticalContainer(HCL(mw, ah, pw, HorizontalContainer(AllData(_, _, nh, nw, nrw, nt, ninfo, nbgColor), es), hcs))) ->
      Element(AllData(px, py, h, w, rw, t, info, bgColor), VerticalContainer(HCL(mw, ah, pw, HorizontalContainer(AllData(px, py, nh, nw, nrw, nt, ninfo, nbgColor), es), hcs)))
