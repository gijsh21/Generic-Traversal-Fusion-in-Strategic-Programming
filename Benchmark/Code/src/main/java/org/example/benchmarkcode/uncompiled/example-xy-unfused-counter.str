module example-xy-unfused-counter
imports libstratego-lib

signature
  sorts
    Exp
    Int

  constructors
    Z : Int
    S : Int -> Int
    Null : Exp
    E : Exp * Exp * Int * Int * Int -> Exp
    Plus : Int * Int -> Int
    Mult : Int * Int -> Int

strategies
  f_main = ?Null() < f_main_Null + ?S(_) < f_main_S + ?Mult(_, _) < f_main_Mult + ?E(_, _, _, _, _) < f_main_E + ?Z() < f_main_Z + ?Plus(_, _) < f_main_Plus + id
f_1 = ?Null() < f_1_Null + ?S(_) < f_1_S + ?Mult(_, _) < f_1_Mult + ?E(_, _, _, _, _) < f_1_E + ?Z() < f_1_Z + ?Plus(_, _) < f_1_Plus + id
f_0 = ?Null() < f_0_Null + ?S(_) < f_0_S + ?Mult(_, _) < f_0_Mult + ?E(_, _, _, _, _) < f_0_E + ?Z() < f_0_Z + ?Plus(_, _) < f_0_Plus + id
f_main_Null = r1; r2
f_main_S = r1; r2; S(f_0); S(f_1)
f_main_Mult = r1; Mult(f_1, f_0); Mult(id, f_1); r2; Mult(f_0, id)
f_main_E = (E(id, f_0, id, f_0, f_0); E(id, f_1, f_0, id, id); r1; E(f_0, id, f_1, id, id); r2; E(f_1, id, id, f_1, f_1)); where(<next-counter> "vc")
f_main_Z = r1; r2
f_main_Plus = r1; Plus(f_1, f_0); Plus(id, f_1); r2; Plus(f_0, id)
f_1_Null = r2
f_1_S = r2; S(f_1)
f_1_Mult = Mult(f_1, f_1); r2
f_1_E = (E(id, f_1, f_1, id, id); r2; E(f_1, id, id, f_1, f_1)); where(<next-counter> "vc")
f_1_Z = r2
f_1_Plus = Plus(f_1, f_1); r2
f_0_Null = r1
f_0_S = r1; S(f_0)
f_0_Mult = r1; Mult(f_0, f_0)
f_0_E = (E(id, f_0, f_0, f_0, f_0); r1; E(f_0, id, id, id, id)); where(<next-counter> "vc")
f_0_Z = r1
f_0_Plus = r1; Plus(f_0, f_0)
  
  main: list -> resultt
  where
  	[_, filename | _] := list
	; inp := <open(!filename)>
	; result := <f_main> inp
	; resultt := <get-counter> "vc"
	

rules
  r1 :
    E(l, r, v, x, y) -> E(l, r, Plus(v, S(Z())), x, y)

  r2 :
    E(l, r, v, x, y) -> E(l, r, v, Plus(x, S(Z())), y)

  r1 :
    Z() -> Z()
  r1 :
    S(n) -> S(n)
  r1 :
    Null() -> Null()
  r1 :
    Plus(a, b) -> Plus(a, b)
  r1 :
    Mult(a, b) -> Mult(a, b)

  r2 :
    Z() -> Z()
  r2 :
    S(n) -> S(n)
  r2 :
    Null() -> Null()
  r2 :
    Plus(a, b) -> Plus(a, b)
  r2 :
    Mult(a, b) -> Mult(a, b)
