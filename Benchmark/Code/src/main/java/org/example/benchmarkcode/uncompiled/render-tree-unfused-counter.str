  main: list -> resultt
  where
  	[_, filename | _] := list
	; inp := <open(!filename)>
	; result := <f_main> inp
	; resultt := <get-counter> "vc"
  
rules
  r-resolve-flex-width :
    Page(AllData(px, py, h, _, rw, Flex(), info, bgColor), HCL(mw, ah, pw, hc, hcs)) ->
