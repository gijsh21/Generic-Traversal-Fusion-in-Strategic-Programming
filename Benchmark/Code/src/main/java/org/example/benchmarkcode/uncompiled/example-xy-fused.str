module example-xy-fused
imports libstratego-lib

signature
  sorts
    Exp
    Int

  constructors
    Z : Int
    S : Int -> Int
    Null : Exp
    E : Exp * Exp * Int * Int * Int -> Exp
    Plus : Int * Int -> Int
    Mult : Int * Int -> Int

strategies
  f_main = ?Null() < f_main_Null + ?S(_) < f_main_S + ?Mult(_, _) < f_main_Mult + ?E(_, _, _, _, _) < f_main_E + ?Z() < f_main_Z + ?Plus(_, _) < f_main_Plus + id
  f_main_Null = r2; r1
  f_main_S = r2; r1
  f_main_Mult = r2; r1
  f_main_E = r2; E(f_main, f_main, id, id, id); r1
  f_main_Z = r2; r1
  f_main_Plus = r2; r1
  
  main: list -> resultt
  where
  	[_, filename | _] := list
	; inp := <open(!filename)>
	; result := <f_main> inp
	; resultt := ""

rules
  r1 :
    E(l, r, v, x, y) -> E(l, r, Plus(v, S(Z())), x, y)

  r2 :
    E(l, r, v, x, y) -> E(l, r, v, Plus(x, S(Z())), y)

  r1 :
    Z() -> Z()
  r1 :
    S(n) -> S(n)
  r1 :
    Null() -> Null()
  r1 :
    Plus(a, b) -> Plus(a, b)
  r1 :
    Mult(a, b) -> Mult(a, b)

  r2 :
    Z() -> Z()
  r2 :
    S(n) -> S(n)
  r2 :
    Null() -> Null()
  r2 :
    Plus(a, b) -> Plus(a, b)
  r2 :
    Mult(a, b) -> Mult(a, b)
